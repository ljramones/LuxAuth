# ─── Database ────────────────────────────────────────────────────────
POSTGRES_USER=authplatform
POSTGRES_PASSWORD=authplatform
POSTGRES_DB=authplatform
DATABASE_URL=postgresql+asyncpg://authplatform:authplatform@postgres:5432/authplatform

# ─── AWS / LocalStack ───────────────────────────────────────────────
AWS_ENDPOINT_URL=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# ─── Service ────────────────────────────────────────────────────────
SERVICE_NAME=
SERVICE_PORT=
LOG_LEVEL=DEBUG
CORRELATION_HEADER=X-Correlation-ID

# ─── pgAdmin (optional) ─────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@authplatform.local
PGADMIN_DEFAULT_PASSWORD=admin
